<Window
    x:Class="AgentShell.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Background="#09111A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#111925" Padding="20">
            <StackPanel Spacing="10">
                <TextBlock Text="Настройки агента" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                <Button Content="Локальная модель" Click="LocalAiTabButton_Click" />
                <Button Content="Веб-доступ" Click="WebTabButton_Click" />
                <Button Content="Тулзы" Click="ToolsTabButton_Click" />
                <Button Content="Виджеты" Click="WidgetsTabButton_Click" />
                <Button Margin="0,18,0,0" Content="Сохранить" Click="SaveButton_Click" />
                <Button Content="Бэкап" Click="BackupButton_Click" />
                <Button Content="Экспорт" Click="ExportButton_Click" />
                <Button Content="Восстановить последний" Click="RestoreButton_Click" />
                <TextBlock x:Name="OperationStatusText" Margin="0,10,0,0" Foreground="#8FA6BE" TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Padding="26">
            <ScrollViewer x:Name="LocalAiView" Visibility="Visible">
                <StackPanel Spacing="16">
                    <TextBlock Text="Локальная модель" FontSize="28" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Агент работает только на локальной модели через koboldcpp. Все слои модели должны помещаться в видеопамять, иначе часть уедет в системную RAM и станет медленно." Foreground="#A8B3C4" TextWrapping="WrapWholeWords" />

                    <Border Background="#131D2A" CornerRadius="22" Padding="18">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Что нашлось автоматически" FontSize="18" Foreground="White" />
                            <TextBlock x:Name="DetectedPathsText" Foreground="#A8B3C4" TextWrapping="WrapWholeWords" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Проверить запуск" Click="TestServerButton_Click" />
                                <Button Content="Остановить" Click="StopServerButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#131D2A" CornerRadius="22" Padding="18">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Пути (оставь пустым для автопоиска)" FontSize="18" Foreground="White" />
                            <TextBox x:Name="KoboldPathBox" PlaceholderText="Путь к koboldcpp.exe" />
                            <TextBox x:Name="ModelPathBox" PlaceholderText="Путь к EvoCUA .gguf" />
                            <TextBox x:Name="MmprojPathBox" PlaceholderText="Путь к mmproj .gguf (зрение)" />
                        </StackPanel>
                    </Border>

                    <Border Background="#131D2A" CornerRadius="22" Padding="18">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Параметры запуска" FontSize="18" Foreground="White" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ContextBox" PlaceholderText="Context, например 8192" />
                                <TextBox x:Name="GpuLayersBox" Grid.Column="1" Margin="10,0,0,0" PlaceholderText="GPU слои, 999 = все" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="QuantKvBox" PlaceholderText="KV квант: q8_0 / q4_0 / f16" />
                                <TextBox x:Name="PortBox" Grid.Column="1" Margin="10,0,0,0" PlaceholderText="Порт, например 5002" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ThreadsBox" PlaceholderText="Потоки CPU, например 6" />
                                <TextBox x:Name="ImageMaxPixelsBox" Grid.Column="1" Margin="10,0,0,0" PlaceholderText="Пикселей скриншота, 1310720" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MaxStepsBox" PlaceholderText="Максимум шагов агента, 40" />
                                <TextBox x:Name="IdleUnloadBox" Grid.Column="1" Margin="10,0,0,0" PlaceholderText="Выгружать после простоя, сек" />
                            </Grid>
                            <TextBox x:Name="VisionMaxResBox" PlaceholderText="Разрешение зрения, px (512–2048). Больше — точнее клик, но медленнее шаг" />
                            <TextBox x:Name="ExtraArgsBox" PlaceholderText="Дополнительные флаги koboldcpp" />
                            <CheckBox x:Name="MmprojOnCpuToggle" Content="Держать mmproj на CPU (если зрение не влезает в VRAM)" />
                            <CheckBox x:Name="OcrHintsToggle" Content="Подмешивать OCR-подсказки в промпт" />
                            <CheckBox x:Name="TrayRecoveryToggle" Content="При застревании фокусировать подходящее окно и открывать трей" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="WebView" Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <TextBlock Text="Веб-доступ" FontSize="28" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Тот же агент, что и в панели, но по сети. Открой ссылку с другого устройства — там тот же чат: задача, ход мыслей, ответ, стоп. Токен даёт полный доступ к мыши и клавиатуре этой машины, так что не выставляй порт в интернет без необходимости." Foreground="#A8B3C4" TextWrapping="WrapWholeWords" />

                    <Border Background="#131D2A" CornerRadius="22" Padding="18">
                        <StackPanel Spacing="12">
                            <CheckBox x:Name="WebEnabledToggle" Content="Включить веб-морду" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WebPortBox" PlaceholderText="Порт, например 4798" />
                                <TextBox x:Name="WebBindBox" Grid.Column="1" Margin="10,0,0,0" PlaceholderText="Адрес прослушивания: 0.0.0.0" />
                            </Grid>
                            <TextBox x:Name="WebTokenBox" PlaceholderText="Токен доступа" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Применить и перезапустить" Click="ApplyWebButton_Click" />
                                <Button Content="Новый токен" Click="NewWebTokenButton_Click" />
                                <Button Content="Открыть в браузере" Click="OpenWebButton_Click" />
                            </StackPanel>
                            <TextBlock x:Name="WebStatusText" Foreground="#8FA6BE" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ToolsView" Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <TextBlock Text="Тулзы" FontSize="28" FontWeight="SemiBold" Foreground="White" />
                    <ItemsControl x:Name="ToolsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#131D2A" CornerRadius="20" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="18" />
                                            <TextBlock Text="{Binding Description}" Foreground="#A8B3C4" TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Margin="10,0,0,0" Content="Настройки" IsEnabled="{Binding HasSettings}" />
                                        <Button Grid.Column="2" Margin="10,0,0,0" Content="Удалить" Click="RemoveTool_Click" Tag="{Binding RootPath}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="WidgetsView" Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <TextBlock Text="Виджеты" FontSize="28" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Виджеты могут принимать данные от агента, если это указано в их манифесте." Foreground="#A8B3C4" TextWrapping="WrapWholeWords" />
                    <ItemsControl x:Name="WidgetsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#131D2A" CornerRadius="20" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="18" />
                                            <TextBlock Text="{Binding Description}" Foreground="#A8B3C4" TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Margin="10,0,0,0" Content="Тест" Click="TestWidget_Click" Tag="{Binding RootPath}" />
                                        <Button Grid.Column="2" Margin="10,0,0,0" Content="Настройки" IsEnabled="{Binding HasSettings}" />
                                        <Button Grid.Column="3" Margin="10,0,0,0" Content="Удалить" Click="RemoveWidget_Click" Tag="{Binding RootPath}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
